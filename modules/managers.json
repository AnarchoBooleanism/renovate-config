// Custom managers, including generic Renovate comment types

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "description": "Custom managers, including generic Renovate comment types",
  "customManagers": [
    // Generic
    {
      // Generic type to use for all custom version declarations in YAML
      // Base (note that the amount of whitespace between each part is flexible):
      // # renovate: datasource=<DATASOURCE> depName=<DEPNAME> [versioning=<VERSIONING>] [registryUrl=<REGISTRYURL>]
      // [-] <VERSION_KEY_NAME>: [&<OPTIONAL-ANCHOR-NAME>] "<VERSION_VALUE>"
      //
      // Example:
      // # renovate: datasource=github-releases depName=AnarchoBooleanism/nixos-cloud-init-installer versioning=semver
      // NIXOS_CLOUDINIT_ISO_VERSION: &cloudinit-iso-version "v2.12.0"
      // 
      // You are able to use as much whitespace between tokens as possible, as long as it's valid YAML
      // You're also able to use hyphens, beforehand, too, e.g.:
      // - NIXOS_CLOUDINIT_ISO_VERSION: &cloudinit-iso-version "v2.12.0"
      // 
      // Assuming we only use keys that are strings
      // And that keys and anchors don't need quotes (at least, avoid numbers and dashes as the first character)
      // However, try to use quotes for version name strings in YAML files
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.yml",
        "**/*.yaml"
      ],
      "matchStrings": [
        "(?<comment>[ \\t]*#[ \\t]+renovate:[ \\t]+datasource=(?<datasource>[^\\s]+)[ \\t]+depName=(?<depName>[^\\s]+)(?:[ \\t]+versioning=(?<versioning>[^\\s]+))?(?:[ \\t]+registryUrl=(?<registryUrl>[^\\s]+))?\\s*\\n\\s*)(?<prefix>(?:-\\s+)?[a-zA-Z_][a-zA-Z0-9_-]*:[ \\t]+)(?<anchor>&[a-zA-Z_][a-zA-Z0-9_-]*[ \\t]+)?(?<quote>[\"'])?(?<currentValue>[^\"'\\s]+)(?:[\"'])?"
      ]
    },
    {
      // Generic type to use for all custom version declarations in Dockerfiles
      // When specifying version names, please avoid using quotes!
      // Base (note that the amount of whitespace between each part is flexible):
      // # renovate: datasource=<DATASOURCE> depName=<DEPNAME> [versioning=<VERSIONING>]
      // ARG VERSION_KEY_NAME=<VERSION_VALUE>
      //
      // Example:
      // # renovate: datasource=github-releases depName=AnarchoBooleanism/nixos-cloud-init-installer versioning=semver
      // ARG NIXOS_CLOUDINIT_ISO_VERSION=v2.12.0
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"
      ],
      "matchStrings": [
        "(?<comment>[ \\t]*#[ \\t]+renovate:[ \\t]+datasource=(?<datasource>[^\\s]+)[ \\t]+depName=(?<depName>[^\\s]+)(?:[ \\t]+versioning=(?<versioning>[^\\s]+))?(?:[ \\t])?\\s*\\n\\s*)ARG[ \\t]+(?<prefix>[a-zA-Z0-9_]+)=(?<currentValue>[^\"'\\s]+)"
      ]
    },

    // More specific
    {
      // Type to use for GitHub Actions runners (e.g. where defined within multi-architecture matrixes)
      // Base (note that the amount of whitespace between each part is flexible):
      // # renovate:github-actions
      // [-] <KEY_NAME>: "<RUNNER_TYPE>-<VERSION_VALUE>"
      //
      // Example (can be within a matrix definition, but this can be anywhere):
      // # renovate:github-runners
      // os: "ubuntu-24.04"  
      // 
      // You are able to use as much whitespace between tokens as possible, as long as it's valid YAML
      // You're also able to use hyphens, beforehand, too, e.g.:
      // # renovate:github-runners
      // - os: "ubuntu-24.04"
      // 
      // Assuming we only use keys that are strings
      // And that keys don't need quotes (at least, avoid numbers and dashes as the first character)
      // Quotes can be used for the values, too
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "matchStrings": [
        // Generally a safe assumption that depName won't have a dash
        "(?<comment>[ \\t]*#[ \\t]+renovate:github-runners\\s*\\n\\s*)(?<prefix>(?:-\\s+)?[a-zA-Z_][a-zA-Z0-9_-]*:[ \\t]+)(?<quote>[\"'])?(?<depName>[^\"'\\-\\s]+)-(?<currentValue>[^\"'\\s]+)(?:[\"'])?"
      ],
      "datasourceTemplate": "github-runners"
    }
  ]
}

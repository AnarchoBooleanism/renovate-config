// Pull request labels, based on package ecosystems

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Labels (most will be defined in packageRules)
  "labels": ["dependencies"],

  // Package rules
  "packageRules": [
    // Labels, specific to package managers

    // NOTE: Unlike Dependabot, Renovate does not set colors for PR labels, so please
    // manually set colors (and descriptions) for labels when adding new package managers
    // Each rule below has a color associated with it that you can use.
    // When creating a label in GitHub, use this template for the description:
    // "Pull requests that update <ECOSYSTEM> code"

    // Copied from Dependabot, see: https://github.com/search?q=repo%3Adependabot%2Fdependabot-core+register_label_details&type=code
    // Also see: https://docs.renovatebot.com/modules/manager/
    {
      "addLabels": [".NET"], // Color: #7121C6
      "matchManagers": ["cake", "nuget", "unity3d"]
    },
    { // Renovate-only
      "addLabels": ["ansible"], // Color: TBD
      "matchManagers": ["ansible", "nuget", "unity3d"]
    },
    { // Renovate-only
      "addLabels": ["apm"], // Color: TBD
      "matchManagers": ["apm"]
    },
    { // Renovate-only
      "addLabels": ["asdf"], // Color: TBD
      "matchManagers": ["asdf"]
    },
    { // Renovate-only
      "addLabels": ["batect"], // Color: TBD
      "matchManagers": ["batect", "batech-wrapper"]
    },
    {
      "addLabels": ["bazel"], // Color: #000000
      "matchManagers": ["bazel", "bazel-module", "bazelisk"]
    },
    { // Renovate-only
      "addLabels": ["bicep"], // Color: TBD
      "matchManagers": ["bicep"]
    },
    { // Renovate-only
      "addLabels": ["cdnurl"], // Color: TBD
      "matchManagers": ["cdnurl"]
    },
    { // Renovate-only
      // NOTE: Since we use GitHub Actions, it's unlikely that these will be used,
      // so they are all grouped together as "ci_cd". In the case that, one day,
      // these are used, then they should be moved into a separate label group.
      "addLabels": ["ci_cd"], // Color: TBD
      "matchManagers": [
        "azure-pipelines",
        "bitbucket-pipelines",
        "bitrise",
        "buildkite",
        "circleci",
        "crow",
        "droneci",
        "gitlabci",
        "jenkins",
        "travis",
        "velaci",
        "woodpecker"
      ]
    },
    { // Renovate-only
      "addLabels": ["conan"], // Color: TBD
      "matchManagers": ["conan"]
    },
    { // Custom-made for here
      "addLabels": ["custom_managers"], // Color: #000000
      "matchManagers": ["regex", "jsonata"] 
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["conda"] // Color: #44A047
    // },
    {
      "addLabels": ["devcontainers_package_manager"], // Color: #2753E3
      "matchManagers": ["devcontainer"]
    },
    { // Renovate-only
      "addLabels": ["devbox"], // Color: #21CEFF
      "matchManagers": ["devbox"]
    },
    {
      "addLabels": ["docker"], // Color: #21CEFF
      "matchManagers": ["buildpacks", "dockerfile", "quadlet"]
    },
    {
      "addLabels": ["docker_compose"], // Color: #E5F2FC
      "matchManagers": ["docker-compose"]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["dotnet_sdk_package_manager"] // Color: #512BD4
    // },
    {
      "addLabels": ["dart"], // Color: #000000
      "matchManagers": ["fvm", "pub"]
    },
    {
      "addLabels": ["deno"], // Color: #70FFAF
      "matchManagers": ["deno"]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["dummy"] // Color: #CE2D2D
    // },
    {
      "addLabels": ["elixir"], // Color: #9380DD
      "matchManagers": ["gleam", "mix"]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["elm"] // Color: #96D3F2
    // },
    {
      "addLabels": ["github_actions"], // Color: #000000
      "matchManagers": ["github-actions"]
    },
    {
      "addLabels": ["go"], // Color: #16E2E2
      "matchManagers": ["gomod", "ocb"]
    },
    { // Renovate-only
      "addLabels": ["haskell"], // Color: TBD
      "matchManagers": ["haskell-cabal"]
    },
    {
      "addLabels": ["helm"], // Color: #E5F2FC
      "matchManagers": [
        "helm-requirements",
        "helm-values",
        "helmfile",
        "helmsman",
        "helmv3",
        "vendir"
      ]
    },
    { // Renovate-only
      "addLabels": ["hermit"], // Color: TBD
      "matchManagers": ["hermit"]
    },
    { // Renovate-only
      "addLabels": ["homebrew"], // Color: TBD
      "matchManagers": ["homebrew"]
    },
    { // Renovate-only
      "addLabels": ["html"], // Color: TBD
      "matchManagers": ["html"]
    },
    {
      "addLabels": ["java"], // Color: #FFA221
      "matchManagers": [
        "ant",
        "deps-edn",
        "gradle",
        "gradle-wrapper",
        "kotlin-script",
        "leiningen",
        "maven",
        "maven-wrapper",
        "osgi",
        "scalafmt",
        "smithy"
      ]
    },
    {
      "addLabels": ["javascript"], // Color: #168700
      "matchManagers": [
        "bun",
        "bun-version",
        "meteor",
        "nodenv",
        "npm",
        "nvm"
      ]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["julia"] // Color: #A270BA
    // },
    { // Renovate-only
      "addLabels": ["kubernetes"], // Color: TBD
      "matchManagers": [
        "argocd",
        "crossplane",
        "fleet",
        "flux",
        "glasskube",
        "jsonnet-bundler",
        "kubernetes",
        "kustomize",
        "sveltos"
      ]
    },
    { // Renovate-only
      "addLabels": ["mise"], // Color: TBD
      "matchManagers": ["mise"]
    },
    {
      "addLabels": ["nix"], // Color: #3E6399
      "matchManagers": ["nix"]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["opentofu"] // Color: #F9DB4E
    // },
    {
      "addLabels": ["perl"], // Color: TBD
      "matchManagers": ["cpanfile"]
    },
    {
      "addLabels": ["php"], // Color: #45229E
      "matchManagers": ["composer"]
    },
    {
      "addLabels": ["pre_commit"], // Color: #000000
      "matchManagers": ["pre-commit"]
    },
    { // Renovate-only
      "addLabels": ["proto"], // Color: TBD
      "matchManagers": ["proto"]
    },
    {
      "addLabels": ["python"], // Color: #2B67C6
      "matchManagers": [
        "copier",
        "homeassistant-manifest",
        "pep621",
        "pep723",
        "pip-compile",
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "pixi",
        "poetry",
        "pyenv",
        "runtime-version",
        "setup-cfg"
      ]
    },
    // { // Does not exist in Renovate (explicitly, at least)
    //   "addLabels": ["python:uv"] // Color: #2B67C6
    // },
    {
      "addLabels": ["renovate-config"], // Color: #000000
      "matchManagers": ["renovate-config"]
    },
    {
      "addLabels": ["ruby"], // Color: #CE2D2D
      "matchManagers": ["bundler", "puppet", "ruby-version"]
    },
    {
      "addLabels": ["rust"], // Color: #000000
      "matchManagers": ["cargo"]
    },
    {
      "addLabels": ["rust_toolchain_package_manager"], // Color: #D34516
      "matchManagers": ["rust-toolchain"]
    },
    {
      "addLabels": ["sbt"], // Color: #000000
      "matchManagers": ["sbt"]
    },
    {
      "addLabels": ["swift_package_manager"], // Color: #F05138
      "matchManagers": [
        "cocoapods",
        "mint",
        "swift",
        "xcodegen"
      ]
    },
    // { // Does not exist in Renovate
    //   "addLabels": ["silent_package_manager"] // Color: #000000
    // },
    {
      "addLabels": ["submodules"], // Color: #000000
      "matchManagers": ["git-submodules"]
    },
    { // Renovate-only
      "addLabels": ["tekton"], // Color: TBD
      "matchManagers": ["tekton"]
    },
    { // Renovate-only
      "addLabels": ["typst"], // Color: TBD
      "matchManagers": ["typst"]
    },
    {
      "addLabels": ["terraform"], // Color: #5C4EE5
      "matchManagers": [
        "terraform",
        "terraform-version",
        "terragrunt",
        "terragrunt-version",
        "tflint-plugin"
      ]
    }
    // { // Does not exist in Renovate
    //   "addLabels": ["vcpkg"] // Color: #FBCA04
    // }
  ]
}
